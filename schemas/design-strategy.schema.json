{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sah.dev/schemas/design-strategy/v0.1.0",
  "title": "SAH Design Strategy IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "characterizationRef", "selections", "compositionContracts", "shortPath"],
  "properties": {
    "schemaVersion": {"const": "0.1.0", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["schema-validator", "S13"]}},
    "modelId": {"$ref": "#/$defs/id", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S6", "S13"]}},
    "characterizationRef": {"$ref": "#/$defs/id", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["reference-validator", "S3", "S4"]}},
    "selections": {"type": "array", "items": {"$ref": "#/$defs/selection"}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S6", "S7", "benchmark-judge"]}},
    "compositionContracts": {"type": "array", "items": {"$ref": "#/$defs/compositionContract"}, "x-sah-trace": {"writtenBy": ["S2", "S5", "S6"], "readBy": ["S5", "S6", "S8", "S9"]}},
    "shortPath": {"$ref": "#/$defs/shortPath", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S8", "ceremony-validator"]}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "strategy": {"enum": ["transaction-script-modular", "responsibility-centered-domain", "functional-dataflow", "state-machine-concurrent", "distributed-event-driven", "integration-adapter", "agentic-tool-loop"]},
    "rationale": {
      "type": "object", "additionalProperties": false,
      "required": ["dimensionIds", "evidenceRefs", "text"],
      "properties": {
        "dimensionIds": {"type": "array", "items": {"enum": ["rule_change_complexity", "invariant_criticality", "dataflow_orientation", "distribution_consistency", "concurrency_temporality", "autonomy_uncertainty", "integration_volatility", "scale_performance", "assurance_governance", "change_isolation"]}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["strategy-trace-validator", "benchmark-judge"]}},
        "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["trace-validator", "S9"]}},
        "text": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "human-reviewer"]}}
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "benefits", "costs", "rejectedBecause", "reversalEvidence"],
      "properties": {
        "strategy": {"$ref": "#/$defs/strategy", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9", "benchmark-judge"]}},
        "benefits": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9"]}},
        "costs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9", "benchmark-judge"]}},
        "rejectedBecause": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9", "benchmark-judge"]}},
        "reversalEvidence": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S13"]}}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["subsystemRef", "dominantStrategy", "supportingStrategies", "rationale", "alternatives", "disqualifiers", "costs", "confidence"],
      "properties": {
        "subsystemRef": {"$ref": "#/$defs/id", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["reference-validator", "S3", "S4", "S6"]}},
        "dominantStrategy": {"$ref": "#/$defs/strategy", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S6", "S7", "benchmark-judge"]}},
        "supportingStrategies": {"type": "array", "items": {"$ref": "#/$defs/strategy"}, "uniqueItems": true, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S6"]}},
        "rationale": {"$ref": "#/$defs/rationale", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S9"]}},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9", "benchmark-judge"]}},
        "disqualifiers": {"type": "array", "items": {"type": "string", "minLength": 1}, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S13"]}},
        "costs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9", "benchmark-judge"]}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S9", "S10"]}}
      }
    },
    "compositionContract": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fromSubsystemRef", "toSubsystemRef", "interactionMode", "semanticContract", "factOwner", "timing", "consistency", "failureHandling", "translationOwner", "qualityScenarioRefs", "invariantRefs"],
      "properties": {
        "id": {"$ref": "#/$defs/id", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["reference-validator", "S6"]}},
        "fromSubsystemRef": {"$ref": "#/$defs/id", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["reference-validator", "S6"]}},
        "toSubsystemRef": {"$ref": "#/$defs/id", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["reference-validator", "S6"]}},
        "interactionMode": {"enum": ["call", "message", "stream", "batch-transfer", "shared-artifact", "human-handoff"], "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S6", "S7", "S8"]}},
        "semanticContract": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2", "S6"], "readBy": ["S6", "S8", "S11"]}},
        "factOwner": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2", "S5"], "readBy": ["S6", "S11"]}},
        "timing": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2", "S6"], "readBy": ["S8", "S9"]}},
        "consistency": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2", "S5", "S6"], "readBy": ["S8", "S9", "S11"]}},
        "failureHandling": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2", "S6"], "readBy": ["S8", "S9", "S12"]}},
        "translationOwner": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2", "S5"], "readBy": ["S6", "S12"]}},
        "qualityScenarioRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["reference-validator", "S8", "S9"]}},
        "invariantRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "x-sah-trace": {"writtenBy": ["S5", "S6"], "readBy": ["reference-validator", "S8", "S11"]}}
      }
    },
    "shortPath": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "rationale", "disqualifyingForces"],
      "properties": {
        "eligible": {"type": "boolean", "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S8", "ceremony-validator"]}},
        "rationale": {"type": "string", "minLength": 1, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["human-reviewer", "benchmark-judge"]}},
        "disqualifyingForces": {"type": "array", "items": {"type": "string", "minLength": 1}, "x-sah-trace": {"writtenBy": ["S2"], "readBy": ["S3", "S4", "S13"]}}
      }
    }
  },
  "examples": [{
    "schemaVersion": "0.1.0",
    "modelId": "catalog-admin-strategy",
    "characterizationRef": "catalog-admin-characterization",
    "selections": [{
      "subsystemRef": "catalog-admin",
      "dominantStrategy": "transaction-script-modular",
      "supportingStrategies": [],
      "rationale": {"dimensionIds": ["rule_change_complexity", "invariant_criticality"], "evidenceRefs": ["ev-product-edit"], "text": "Independent record changes and local validation favor direct operations"},
      "alternatives": [{"strategy": "responsibility-centered-domain", "benefits": ["Room for richer rules"], "costs": ["Modeling ceremony"], "rejectedBecause": "No interacting rules are evidenced", "reversalEvidence": "Rules begin coordinating product changes"}],
      "disqualifiers": ["A critical invariant spans products"],
      "costs": ["Behavior may scatter if rules grow"],
      "confidence": 0.9
    }],
    "compositionContracts": [],
    "shortPath": {"eligible": true, "rationale": "Local reversible CRUD with no critical invariant", "disqualifyingForces": ["Distribution", "cross-record invariant", "probabilistic autonomy"]}
  }]
}
