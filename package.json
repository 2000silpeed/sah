{
  "name": "software-architect-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Methodology-neutral design reasoning validation harness",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sah": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \"schemas/benchmark-run.schema.json\" \"schemas/benchmark-freeze.schema.json\" \"schemas/benchmark-judge-review.schema.json\" \"schemas/benchmark-score.schema.json\" \"schemas/benchmark-adjudication.schema.json\" \"schemas/benchmark-verdict.schema.json\" \"schemas/benchmark-comparison.schema.json\" \"schemas/benchmark-trajectory-entry.schema.json\" \"schemas/design-bundle-manifest.schema.json\" \"schemas/design-bundle-manifest-v0.5.0.schema.json\" \"schemas/architecture-evolution.schema.json\" \"schemas/lineage-result.schema.json\" \"schemas/current-architecture-result.schema.json\" \"schemas/implementation-handoff.schema.json\" \"schemas/typescript-source-mapping.schema.json\" \"schemas/verification-check.schema.json\" \"schemas/verification-diagnostic.schema.json\" \"schemas/verification-record.schema.json\" \"schemas/verification-result.schema.json\" \"schemas/review-disposition.schema.json\" \"schemas/resume-result.schema.json\" \"schemas/iteration-completion.schema.json\" \"schemas/iteration-scenario.schema.json\" \"schemas/iteration-slice.schema.json\" \"schemas/iteration-outcome.schema.json\" \"schemas/iteration-loop.schema.json\" \"schemas/iteration-loop-result.schema.json\" \"schemas/checker-review.schema.json\" \"fixtures/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \"schemas/benchmark-run.schema.json\" \"schemas/benchmark-freeze.schema.json\" \"schemas/benchmark-judge-review.schema.json\" \"schemas/benchmark-score.schema.json\" \"schemas/benchmark-adjudication.schema.json\" \"schemas/benchmark-verdict.schema.json\" \"schemas/benchmark-comparison.schema.json\" \"schemas/benchmark-trajectory-entry.schema.json\" \"schemas/design-bundle-manifest.schema.json\" \"schemas/design-bundle-manifest-v0.5.0.schema.json\" \"schemas/architecture-evolution.schema.json\" \"schemas/lineage-result.schema.json\" \"schemas/current-architecture-result.schema.json\" \"schemas/implementation-handoff.schema.json\" \"schemas/typescript-source-mapping.schema.json\" \"schemas/verification-check.schema.json\" \"schemas/verification-diagnostic.schema.json\" \"schemas/verification-record.schema.json\" \"schemas/verification-result.schema.json\" \"schemas/review-disposition.schema.json\" \"schemas/resume-result.schema.json\" \"schemas/iteration-completion.schema.json\" \"schemas/iteration-scenario.schema.json\" \"schemas/iteration-slice.schema.json\" \"schemas/iteration-outcome.schema.json\" \"schemas/iteration-loop.schema.json\" \"schemas/iteration-loop-result.schema.json\" \"schemas/checker-review.schema.json\" \"fixtures/**/*.json\"",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build --silent && vitest run",
    "verify:schemas": "vitest run test/schema-contracts.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
