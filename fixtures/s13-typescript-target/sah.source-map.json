{
  "$schema": "https://sah.dev/schemas/typescript-source-mapping/v0.2.0",
  "schemaVersion": "0.2.0",
  "language": "typescript",
  "tsconfigPath": "tsconfig.json",
  "sourceRoots": ["src"],
  "elements": [
    {
      "elementRef": "equipment-operations",
      "pathPrefixes": ["src/equipment-operations/"]
    }
  ],
  "writeTargets": [
    {
      "selector": "equipment-records",
      "modulePath": "src/equipment-store.ts",
      "exportName": "writeEquipmentRecord"
    }
  ]
}
